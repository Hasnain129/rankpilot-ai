        && isValidOrder(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsWebsite(incoming().websiteId);
      allow update: if isValidId(orderId)
        && isVerified()
        && isValidOrder(incoming())
        && existing().ownerId == request.auth.uid
        && existing().status != 'Refunded'
        && incoming().ownerId == existing().ownerId
        && incoming().websiteId == existing().websiteId
        && incoming().entrySource == existing().entrySource
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['orderNumber', 'customerName', 'customerEmail', 'productOrService', 'amount', 'currency', 'channel', 'status', 'orderDate', 'updatedAt'])
        );
      allow delete: if isValidId(orderId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /integrations/{integrationId} {
      allow get: if isValidId(integrationId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(integrationId)
        && isVerified()
        && incoming().keys().hasAll(['ownerId', 'websiteId', 'provider', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['ownerId', 'websiteId', 'provider', 'status', 'identifier', 'notes', 'createdAt', 'updatedAt'])
        && isValidIntegrationConfig(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsWebsite(incoming().websiteId);
      allow update: if isValidId(integrationId)
        && isVerified()
        && isValidIntegrationConfig(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().websiteId == existing().websiteId
        && incoming().provider == existing().provider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'identifier', 'notes', 'updatedAt']);
      allow delete: if isValidId(integrationId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /competitors/{compId} {
      allow get: if isValidId(compId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(compId)
        && isVerified()
        && incoming().keys().hasAll(['ownerId', 'websiteId', 'competitorDomain', 'competitorUrl', 'crawledPages', 'discoveredKeywords', 'keywordOverlapCount', 'keywordGaps', 'contentOpportunities', 'estimatedVisibilityScore', 'dataNotice', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['ownerId', 'websiteId', 'competitorDomain', 'competitorUrl', 'notes', 'lastAnalyzedAt', 'crawledPages', 'discoveredKeywords', 'keywordOverlapCount', 'keywordGaps', 'contentOpportunities', 'estimatedVisibilityScore', 'dataNotice', 'createdAt', 'updatedAt'])
        && isValidCompetitorAnalysis(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsWebsite(incoming().websiteId);
      allow update: if isValidId(compId)
        && isVerified()
        && isValidCompetitorAnalysis(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().websiteId == existing().websiteId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(compId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /backlinkAnalyses/{blId} {
      allow get: if isValidId(blId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(blId)
        && isVerified()
        && incoming().keys().hasAll(['ownerId', 'websiteId', 'targetDomain', 'sourceStatus', 'externalOutboundDomainsCount', 'internalLinksAnalyzed', 'anchorTextDistribution', 'orphanRiskPages', 'publicMentionResults', 'brokenOutboundLinks', 'providerNotice', 'createdAt'])
        && incoming().keys().hasOnly(['ownerId', 'websiteId', 'targetDomain', 'sourceStatus', 'externalOutboundDomainsCount', 'internalLinksAnalyzed', 'anchorTextDistribution', 'orphanRiskPages', 'publicMentionResults', 'brokenOutboundLinks', 'providerNotice', 'createdAt'])
        && isValidBacklinkAnalysis(incoming())
        && incoming().createdAt == request.time
        && ownsWebsite(incoming().websiteId);
      allow update: if false;
      allow delete: if isValidId(blId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /seoRecommendations/{recId} {
      allow get: if isValidId(recId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(recId)
        && isVerified()
        && incoming().keys().hasAll(['ownerId', 'websiteId', 'category', 'priority', 'status', 'affectedPage', 'whatIsWrong', 'whyItMatters', 'howToFix', 'expectedBenefit', 'sourceBasis', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['ownerId', 'websiteId', 'category', 'priority', 'status', 'affectedPage', 'whatIsWrong', 'whyItMatters', 'howToFix', 'expectedBenefit', 'sourceBasis', 'createdAt', 'updatedAt'])
        && isValidAiSeoRecommendation(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsWebsite(incoming().websiteId);
      allow update: if isValidId(recId)
        && isVerified()
        && isValidAiSeoRecommendation(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().websiteId == existing().websiteId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(recId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /analyticsSnapshots/{snapId} {
      allow get: if isValidId(snapId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(snapId)
        && isVerified()
        && incoming().keys().hasAll(['ownerId', 'websiteId', 'propertyId', 'dateRangeStart', 'dateRangeEnd', 'totalUsers', 'newUsers', 'returningUsers', 'sessions', 'organicSessions', 'directSessions', 'referralSessions', 'campaignSessions', 'conversions', 'conversionRate', 'purchaseRevenue', 'hasVerifiedRevenue', 'trafficSources', 'topLandingPages', 'campaignPerformance', 'dailySeries', 'createdAt'])
        && incoming().keys().hasOnly(['ownerId', 'websiteId', 'propertyId', 'dateRangeStart', 'dateRangeEnd', 'totalUsers', 'newUsers', 'returningUsers', 'sessions', 'organicSessions', 'directSessions', 'referralSessions', 'campaignSessions', 'conversions', 'conversionRate', 'purchaseRevenue', 'hasVerifiedRevenue', 'trafficSources', 'topLandingPages', 'campaignPerformance', 'dailySeries', 'createdAt'])
        && isValidAnalyticsSnapshot(incoming())
        && incoming().createdAt == request.time
        && ownsWebsite(incoming().websiteId);
      allow update: if false;
      allow delete: if isValidId(snapId) && isVerified() && existing().ownerId == request.auth.uid;
    }
  }
}
