rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net — deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Helpers
    // -------------------------------------------------------------------------

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function ownsWebsite(websiteId) {
      return isValidId(websiteId)
        && exists(/databases/$(database)/documents/websites/$(websiteId))
        && get(/databases/$(database)/documents/websites/$(websiteId)).data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Called on BOTH create and update)
    // -------------------------------------------------------------------------

    function isValidUserProfile(data) {
      return data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isStr(data.email, 3, 254)
        && isStr(data.displayName, 1, 120)
        && (!('companyName' in data) || isStr(data.companyName, 0, 120))
        && data.role == 'member'
        && data.plan == 'free'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebsite(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isStr(data.name, 1, 120)
        && isStr(data.url, 4, 500)
        && isStr(data.domain, 3, 253)
        && (!('industry' in data) || isStr(data.industry, 0, 80))
        && isValidId(data.trackingId)
        && data.trackingId.size() >= 6
        && data.trackingId.size() <= 64
        && data.seoScore is number
        && data.seoScore >= 0
        && data.seoScore <= 100
        && data.pagesScanned is int
        && data.pagesScanned >= 0
        && data.pagesScanned <= 100000
        && data.status in ['active', 'paused']
        && (!('lastScannedAt' in data) || isStr(data.lastScannedAt, 0, 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackingKey(data) {
      return isValidId(data.trackingId)
        && data.trackingId.size() >= 6
        && data.trackingId.size() <= 64
        && isValidId(data.websiteId)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isStr(data.domain, 3, 253)
        && data.createdAt is timestamp;
    }

    function isValidSeoAudit(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.url, 4, 500)
        && data.score is int
        && data.score >= 0
        && data.score <= 100
        && data.loadTimeMs is int
        && data.loadTimeMs >= 0
        && data.loadTimeMs <= 120000
        && data.httpStatus is int
        && data.httpStatus >= 0
        && data.httpStatus <= 599
        && isStr(data.title, 0, 300)
        && isStr(data.metaDescription, 0, 600)
        && data.h1Count is int && data.h1Count >= 0 && data.h1Count <= 1000
        && data.h2Count is int && data.h2Count >= 0 && data.h2Count <= 5000
        && data.h3Count is int && data.h3Count >= 0 && data.h3Count <= 5000
        && data.wordCount is int && data.wordCount >= 0 && data.wordCount <= 500000
        && data.totalImages is int && data.totalImages >= 0 && data.totalImages <= 5000
        && data.missingAltCount is int && data.missingAltCount >= 0 && data.missingAltCount <= 5000
        && data.internalLinks is int && data.internalLinks >= 0 && data.internalLinks <= 20000
        && data.externalLinks is int && data.externalLinks >= 0 && data.externalLinks <= 20000
        && data.brokenLinksCount is int && data.brokenLinksCount >= 0 && data.brokenLinksCount <= 1000
        && (!('brokenLinks' in data) || (data.brokenLinks is list && data.brokenLinks.size() <= 20 && (data.brokenLinks.size() == 0 || data.brokenLinks[0] is string)))
        && data.hasViewport is bool
        && data.hasCanonical is bool
        && data.hasOpenGraph is bool
        && data.mobileFriendly is bool
        && (!('redirectChain' in data) || (data.redirectChain is list && data.redirectChain.size() <= 20 && (data.redirectChain.size() == 0 || data.redirectChain[0] is string)))
        && (!('redirectCount' in data) || (data.redirectCount is int && data.redirectCount >= 0 && data.redirectCount <= 20))
        && (!('metaRobots' in data) || isStr(data.metaRobots, 0, 200))
        && (!('xRobotsTag' in data) || isStr(data.xRobotsTag, 0, 200))
        && data.issues is list && data.issues.size() <= 30 && (data.issues.size() == 0 || data.issues[0] is map)
        && data.recommendations is list && data.recommendations.size() <= 20 && (data.recommendations.size() == 0 || data.recommendations[0] is map)
        && isStr(data.summary, 0, 2000)
        && data.createdAt is timestamp;
    }

    function isValidSiteCrawl(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.rootUrl, 4, 500)
        && data.pagesCrawled is int && data.pagesCrawled >= 0 && data.pagesCrawled <= 100
        && data.overallScore is int && data.overallScore >= 0 && data.overallScore <= 100
        && data.robotsTxtFound is bool
        && data.robotsBlockingAll is bool
        && data.sitemapFound is bool
        && data.sitemapUrlsCount is int && data.sitemapUrlsCount >= 0 && data.sitemapUrlsCount <= 100000
        && data.duplicateTitlesCount is int && data.duplicateTitlesCount >= 0 && data.duplicateTitlesCount <= 100
        && data.duplicateMetaCount is int && data.duplicateMetaCount >= 0 && data.duplicateMetaCount <= 100
        && data.noindexCount is int && data.noindexCount >= 0 && data.noindexCount <= 100
        && data.brokenLinksCount is int && data.brokenLinksCount >= 0 && data.brokenLinksCount <= 1000
        && data.pages is list && data.pages.size() <= 25 && (data.pages.size() == 0 || data.pages[0] is map)
        && data.siteIssues is list && data.siteIssues.size() <= 30 && (data.siteIssues.size() == 0 || data.siteIssues[0] is map)
        && isStr(data.summary, 0, 2500)
        && data.createdAt is timestamp;
    }

    function isValidWpConnection(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.siteUrl, 4, 500)
        && (!('wpUsername' in data) || isStr(data.wpUsername, 0, 120))
        && data.seoPlugin in ['rank_math', 'yoast', 'none']
        && data.hasWpAppPassword is bool
        && data.hasWcKeys is bool
        && isStr(data.encryptedSecrets, 10, 4000)
        && data.status in ['connected', 'error', 'disconnected']
        && (!('lastSyncAt' in data) || isStr(data.lastSyncAt, 0, 64))
        && (!('syncMessage' in data) || isStr(data.syncMessage, 0, 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWpEntity(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && data.remoteId is int && data.remoteId >= 0 && data.remoteId <= 2000000000
        && data.entityType in ['product', 'category', 'page', 'post']
        && isStr(data.title, 1, 300)
        && (!('slug' in data) || isStr(data.slug, 0, 300))
        && isStr(data.url, 4, 500)
        && (!('status' in data) || isStr(data.status, 0, 40))
        && (!('description' in data) || isStr(data.description, 0, 25000))
        && (!('shortDescription' in data) || isStr(data.shortDescription, 0, 5000))
        && (!('seoTitle' in data) || isStr(data.seoTitle, 0, 300))
        && (!('seoDescription' in data) || isStr(data.seoDescription, 0, 600))
        && (!('focusKeyword' in data) || isStr(data.focusKeyword, 0, 200))
        && data.seoPlugin in ['rank_math', 'yoast', 'none']
        && data.imagesCount is int && data.imagesCount >= 0 && data.imagesCount <= 500
        && data.missingAltCount is int && data.missingAltCount >= 0 && data.missingAltCount <= 500
        && (!('lastImportedAt' in data) || isStr(data.lastImportedAt, 0, 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSeoOptimization(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && (!('entityId' in data) || isStr(data.entityId, 0, 128))
        && data.remoteId is int && data.remoteId >= 0 && data.remoteId <= 2000000000
        && data.entityType in ['product', 'category', 'page', 'post', 'url']
        && isStr(data.targetUrl, 4, 500)
        && (!('targetKeyword' in data) || isStr(data.targetKeyword, 0, 200))
        && data.status in ['pending_review', 'approved', 'rejected', 'applied', 'rolled_back']
        && data.originalSnapshot is map
        && data.optimizedDraft is map
        && data.internalLinksSuggested is list && data.internalLinksSuggested.size() <= 10 && (data.internalLinksSuggested.size() == 0 || data.internalLinksSuggested[0] is map)
        && (!('faqSchemaJson' in data) || isStr(data.faqSchemaJson, 0, 12000))
        && (!('aiNotes' in data) || isStr(data.aiNotes, 0, 2000))
        && (!('verifiedScore' in data) || (data.verifiedScore is int && data.verifiedScore >= 0 && data.verifiedScore <= 100))
        && (!('appliedAt' in data) || isStr(data.appliedAt, 0, 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGscSnapshot(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.propertyUrl, 1, 500)
        && isStr(data.dateRangeStart, 8, 32)
        && isStr(data.dateRangeEnd, 8, 32)
        && data.totalClicks is int && data.totalClicks >= 0
        && data.totalImpressions is int && data.totalImpressions >= 0
        && data.avgCtr is number && data.avgCtr >= 0 && data.avgCtr <= 100
        && data.avgPosition is number && data.avgPosition >= 0 && data.avgPosition <= 1000
        && data.prevClicks is int && data.prevClicks >= 0
        && data.prevImpressions is int && data.prevImpressions >= 0
        && data.dailySeries is list && data.dailySeries.size() <= 90 && (data.dailySeries.size() == 0 || data.dailySeries[0] is map)
        && data.topQueries is list && data.topQueries.size() <= 50 && (data.topQueries.size() == 0 || data.topQueries[0] is map)
        && data.topPages is list && data.topPages.size() <= 50 && (data.topPages.size() == 0 || data.topPages[0] is map)
        && (!('topCountries' in data) || (data.topCountries is list && data.topCountries.size() <= 50 && (data.topCountries.size() == 0 || data.topCountries[0] is map)))
        && (!('topDevices' in data) || (data.topDevices is list && data.topDevices.size() <= 20 && (data.topDevices.size() == 0 || data.topDevices[0] is map)))
        && data.createdAt is timestamp;
    }

    function isValidTrackedKeyword(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.keyword, 1, 200)
        && (!('targetUrl' in data) || isStr(data.targetUrl, 0, 500))
        && isStr(data.country, 2, 16)
        && isStr(data.language, 2, 16)
        && data.device in ['desktop', 'mobile']
        && data.currentPosition is number && data.currentPosition >= 0 && data.currentPosition <= 200
        && data.previousPosition is number && data.previousPosition >= 0 && data.previousPosition <= 200
        && data.bestPosition is number && data.bestPosition >= 0 && data.bestPosition <= 200
        && data.sourceType in ['gsc_verified', 'serp_api', 'unverified']
        && data.clicks is int && data.clicks >= 0
        && data.impressions is int && data.impressions >= 0
        && data.history is list && data.history.size() <= 60 && (data.history.size() == 0 || data.history[0] is map)
        && (!('lastCheckedAt' in data) || isStr(data.lastCheckedAt, 0, 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTechnicalSnapshot(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.url, 4, 500)
        && data.strategy in ['mobile', 'desktop']
        && data.performanceScore is int && data.performanceScore >= 0 && data.performanceScore <= 100
        && data.seoScore is int && data.seoScore >= 0 && data.seoScore <= 100
        && data.accessibilityScore is int && data.accessibilityScore >= 0 && data.accessibilityScore <= 100
        && data.bestPracticesScore is int && data.bestPracticesScore >= 0 && data.bestPracticesScore <= 100
        && data.lcpMs is number && data.lcpMs >= 0 && data.lcpMs <= 120000
        && data.cls is number && data.cls >= 0 && data.cls <= 100
        && data.inpMs is number && data.inpMs >= 0 && data.inpMs <= 120000
        && data.fcpMs is number && data.fcpMs >= 0 && data.fcpMs <= 120000
        && data.ttfbMs is number && data.ttfbMs >= 0 && data.ttfbMs <= 120000
        && (!('robotsStatus' in data) || isStr(data.robotsStatus, 0, 120))
        && (!('sitemapStatus' in data) || isStr(data.sitemapStatus, 0, 120))
        && data.opportunities is list && data.opportunities.size() <= 15 && (data.opportunities.size() == 0 || data.opportunities[0] is map)
        && data.createdAt is timestamp;
    }

    function isValidSyncLog(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && data.channel in ['wordpress', 'woocommerce', 'gsc', 'ga4', 'rank_tracker', 'crawler', 'pagespeed', 'competitors', 'backlinks', 'recommendations']
        && isStr(data.action, 1, 120)
        && data.status in ['success', 'error', 'warning']
        && isStr(data.detail, 0, 1000)
        && data.createdAt is timestamp;
    }

    function isValidKeywordResearch(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && (!('websiteId' in data) || isStr(data.websiteId, 0, 128))
        && isStr(data.seedKeyword, 1, 160)
        && (!('targetMarket' in data) || isStr(data.targetMarket, 0, 80))
        && (!('country' in data) || isStr(data.country, 2, 16))
        && (!('language' in data) || isStr(data.language, 2, 16))
        && (!('sourceType' in data) || data.sourceType in ['keyword', 'product', 'url', 'category'])
        && (!('targetUrl' in data) || isStr(data.targetUrl, 0, 500))
        && (!('dataNotice' in data) || isStr(data.dataNotice, 0, 600))
        && data.relatedKeywords is list && data.relatedKeywords.size() <= 25 && (data.relatedKeywords.size() == 0 || data.relatedKeywords[0] is map)
        && data.longTailKeywords is list && data.longTailKeywords.size() <= 25 && (data.longTailKeywords.size() == 0 || data.longTailKeywords[0] is map)
        && (!('keywordItems' in data) || (data.keywordItems is list && data.keywordItems.size() <= 80 && (data.keywordItems.size() == 0 || data.keywordItems[0] is map)))
        && (!('synonyms' in data) || (data.synonyms is list && data.synonyms.size() <= 30 && (data.synonyms.size() == 0 || data.synonyms[0] is string)))
        && (!('opportunities' in data) || (data.opportunities is list && data.opportunities.size() <= 25 && (data.opportunities.size() == 0 || data.opportunities[0] is map)))
        && (!('assignments' in data) || (data.assignments is list && data.assignments.size() <= 80 && (data.assignments.size() == 0 || data.assignments[0] is map)))
        && data.clusters is list && data.clusters.size() <= 15 && (data.clusters.size() == 0 || data.clusters[0] is map)
        && data.contentIdeas is list && data.contentIdeas.size() <= 15 && (data.contentIdeas.size() == 0 || data.contentIdeas[0] is map)
        && data.suggestedTitles is list && data.suggestedTitles.size() <= 15 && (data.suggestedTitles.size() == 0 || data.suggestedTitles[0] is string)
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidGeneratedContent(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && (!('websiteId' in data) || isStr(data.websiteId, 0, 128))
        && data.contentType in ['blog', 'meta_title', 'meta_description', 'product_description', 'landing_page', 'faq']
        && isStr(data.title, 1, 240)
        && (!('targetKeyword' in data) || isStr(data.targetKeyword, 0, 160))
        && isStr(data.body, 1, 25000)
        && (!('metaTitle' in data) || isStr(data.metaTitle, 0, 160))
        && (!('metaDescription' in data) || isStr(data.metaDescription, 0, 320))
        && data.status in ['draft', 'published']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVisitorEvent(data) {
      return isValidId(data.ownerId)
        && isValidId(data.websiteId)
        && isValidId(data.trackingId)
        && data.trackingId.size() >= 6
        && data.trackingId.size() <= 64
        && isStr(data.visitorId, 1, 128)
        && isStr(data.sessionId, 1, 128)
        && data.eventType in ['pageview', 'conversion', 'lead_submit', 'quote_request']
        && isStr(data.path, 1, 500)
        && (!('referrer' in data) || isStr(data.referrer, 0, 500))
        && isStr(data.trafficSource, 1, 80)
        && (!('utmSource' in data) || isStr(data.utmSource, 0, 120))
        && (!('utmMedium' in data) || isStr(data.utmMedium, 0, 120))
        && (!('utmCampaign' in data) || isStr(data.utmCampaign, 0, 120))
        && data.deviceType in ['desktop', 'mobile', 'tablet']
        && data.conversionValue is number
        && data.conversionValue >= 0
        && data.conversionValue <= 10000000
        && data.createdAt is timestamp;
    }

    function isValidLead(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.name, 1, 140)
        && isStr(data.email, 3, 254)
        && (!('phone' in data) || isStr(data.phone, 0, 40))
        && (!('company' in data) || isStr(data.company, 0, 140))
        && data.leadSource in ['Organic Search', 'Direct', 'Referral', 'Paid Search', 'Social', 'Email', 'Website Form']
        && data.status in ['New', 'Contacted', 'Qualified', 'Converted', 'Lost']
        && data.estimatedValue is number
        && data.estimatedValue >= 0
        && data.estimatedValue <= 100000000
        && (!('notes' in data) || isStr(data.notes, 0, 2000))
        && data.trackingSource in ['tracked', 'manual']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuote(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && (!('leadId' in data) || isStr(data.leadId, 0, 128))
        && isStr(data.customerName, 1, 140)
        && isStr(data.customerEmail, 3, 254)
        && isStr(data.serviceOrProduct, 1, 240)
        && data.amount is number
        && data.amount >= 0
        && data.amount <= 100000000
        && isStr(data.currency, 3, 6)
        && data.status in ['Pending', 'Sent', 'Accepted', 'Rejected']
        && (!('validUntil' in data) || isStr(data.validUntil, 0, 32))
        && (!('notes' in data) || isStr(data.notes, 0, 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.orderNumber, 1, 64)
        && isStr(data.customerName, 1, 140)
        && isStr(data.customerEmail, 3, 254)
        && isStr(data.productOrService, 1, 240)
        && data.amount is number
        && data.amount >= 0
        && data.amount <= 100000000
        && isStr(data.currency, 3, 6)
        && data.channel in ['Organic Search', 'Direct', 'Referral', 'Paid Search', 'Social', 'Manual Entry', 'Shopify', 'WooCommerce']
        && data.entrySource in ['tracked_conversion', 'manual_entry', 'shopify_sync', 'woocommerce_sync']
        && data.status in ['Pending', 'Processing', 'Completed', 'Refunded']
        && isStr(data.orderDate, 8, 32)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIntegrationConfig(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && data.provider in ['google_search_console', 'google_analytics_4', 'google_pagespeed', 'shopify', 'woocommerce', 'wordpress']
        && data.status in ['not_connected', 'configured']
        && (!('identifier' in data) || isStr(data.identifier, 0, 254))
        && (!('notes' in data) || isStr(data.notes, 0, 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitorAnalysis(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.competitorDomain, 3, 253)
        && isStr(data.competitorUrl, 4, 500)
        && (!('notes' in data) || isStr(data.notes, 0, 1000))
        && (!('lastAnalyzedAt' in data) || isStr(data.lastAnalyzedAt, 0, 64))
        && data.crawledPages is list && data.crawledPages.size() <= 15 && (data.crawledPages.size() == 0 || data.crawledPages[0] is map)
        && data.discoveredKeywords is list && data.discoveredKeywords.size() <= 60 && (data.discoveredKeywords.size() == 0 || data.discoveredKeywords[0] is map)
        && data.keywordOverlapCount is int && data.keywordOverlapCount >= 0 && data.keywordOverlapCount <= 1000
        && data.keywordGaps is list && data.keywordGaps.size() <= 40 && (data.keywordGaps.size() == 0 || data.keywordGaps[0] is map)
        && data.contentOpportunities is list && data.contentOpportunities.size() <= 25 && (data.contentOpportunities.size() == 0 || data.contentOpportunities[0] is map)
        && data.estimatedVisibilityScore is int && data.estimatedVisibilityScore >= 0 && data.estimatedVisibilityScore <= 100
        && isStr(data.dataNotice, 0, 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBacklinkAnalysis(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.targetDomain, 3, 253)
        && data.sourceStatus in ['internal_and_serp_check', 'internal_only']
        && data.externalOutboundDomainsCount is int && data.externalOutboundDomainsCount >= 0 && data.externalOutboundDomainsCount <= 10000
        && data.internalLinksAnalyzed is int && data.internalLinksAnalyzed >= 0 && data.internalLinksAnalyzed <= 100000
        && data.anchorTextDistribution is list && data.anchorTextDistribution.size() <= 100 && (data.anchorTextDistribution.size() == 0 || data.anchorTextDistribution[0] is map)
        && data.orphanRiskPages is list && data.orphanRiskPages.size() <= 100 && (data.orphanRiskPages.size() == 0 || data.orphanRiskPages[0] is string)
        && data.publicMentionResults is list && data.publicMentionResults.size() <= 50 && (data.publicMentionResults.size() == 0 || data.publicMentionResults[0] is map)
        && data.brokenOutboundLinks is list && data.brokenOutboundLinks.size() <= 100 && (data.brokenOutboundLinks.size() == 0 || data.brokenOutboundLinks[0] is string)
        && isStr(data.providerNotice, 0, 1000)
        && data.createdAt is timestamp;
    }

    function isValidAiSeoRecommendation(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && data.category in ['technical', 'on_page', 'keyword', 'content', 'internal_linking', 'competitor']
        && data.priority in ['Critical', 'High', 'Medium', 'Low']
        && data.status in ['open', 'in_progress', 'resolved', 'dismissed']
        && isStr(data.affectedPage, 1, 500)
        && isStr(data.whatIsWrong, 1, 1000)
        && isStr(data.whyItMatters, 1, 1000)
        && isStr(data.howToFix, 1, 2000)
        && isStr(data.expectedBenefit, 1, 1000)
        && isStr(data.sourceBasis, 1, 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnalyticsSnapshot(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.websiteId)
        && isStr(data.propertyId, 1, 128)
        && isStr(data.dateRangeStart, 8, 32)
        && isStr(data.dateRangeEnd, 8, 32)
        && data.totalUsers is int && data.totalUsers >= 0
        && data.newUsers is int && data.newUsers >= 0
        && data.returningUsers is int && data.returningUsers >= 0
        && data.sessions is int && data.sessions >= 0
        && data.organicSessions is int && data.organicSessions >= 0
        && data.directSessions is int && data.directSessions >= 0
        && data.referralSessions is int && data.referralSessions >= 0
        && data.campaignSessions is int && data.campaignSessions >= 0
        && data.conversions is int && data.conversions >= 0
        && data.conversionRate is number && data.conversionRate >= 0 && data.conversionRate <= 100
        && data.purchaseRevenue is number && data.purchaseRevenue >= 0
        && data.hasVerifiedRevenue is bool
        && data.trafficSources is list && data.trafficSources.size() <= 40 && (data.trafficSources.size() == 0 || data.trafficSources[0] is map)
        && data.topLandingPages is list && data.topLandingPages.size() <= 60 && (data.topLandingPages.size() == 0 || data.topLandingPages[0] is map)
        && data.campaignPerformance is list && data.campaignPerformance.size() <= 60 && (data.campaignPerformance.size() == 0 || data.campaignPerformance[0] is map)
        && data.dailySeries is list && data.dailySeries.size() <= 95 && (data.dailySeries.size() == 0 || data.dailySeries[0] is map)
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isValidId(userId)
        && isSignedIn()
        && request.auth.uid == userId
        && incoming().keys().hasAll(['uid', 'email', 'displayName', 'role', 'plan', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'email', 'displayName', 'companyName', 'role', 'plan', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isSignedIn()
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().plan == existing().plan
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'companyName', 'email', 'updatedAt']);
      allow delete: if false;
    }

