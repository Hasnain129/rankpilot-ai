        && isValidWebsite(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(websiteId)
        && isVerified()
        && isValidWebsite(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().trackingId == existing().trackingId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['seoScore', 'pagesScanned', 'lastScannedAt', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'url', 'domain', 'industry', 'status', 'updatedAt'])
