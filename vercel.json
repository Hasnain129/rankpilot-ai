{
  "functions": {
    "api/index.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://gen-lang-client-0459883385.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://gen-lang-client-0459883385.firebaseapp.com/__/firebase/init.json"
    },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
