# MANDATORY SERVER ENVIRONMENT VARIABLE
# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional Gemini model overrides (defaults: primary=gemini-4-hydrogen, fallback=gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODELS="gemini-3.1-flash-lite"

# OPTIONAL RUNTIME & INTEGRATION ENVIRONMENT VARIABLES
# APP_URL: The URL where this applet is hosted (injected by AI Studio at runtime).
APP_URL="http://localhost:3000"

# CREDENTIALS_ENCRYPTION_KEY: 32+ char secret used to encrypt WordPress/WooCommerce credentials (server-side AES-256-GCM).
# Recommended for production deployments; falls back cleanly if unset.
CREDENTIALS_ENCRYPTION_KEY=""

# Required for Technical SEO PageSpeed Insights v5 diagnostics (server-side only; anonymous keyless calls are disabled).
PAGESPEED_API_KEY=""
# Optional legacy alias fallback if PAGESPEED_API_KEY is unset:
GOOGLE_PAGESPEED_API_KEY=""

# Optional authorized SERP rank-tracking provider (e.g., "serper") — Google Search Console OAuth works without this.
SERP_API_PROVIDER=""
SERP_API_KEY=""

# Optional server-side Firebase overrides for custom deployments (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=""
FIREBASE_API_KEY=""
FIREBASE_DATABASE_ID=""

# Optional same-origin Firebase Auth proxy domain (set e.g. to "rankpilot-ai-one.vercel.app" on Vercel
# ONLY AFTER deploying the /__/auth/* rewrites in vercel.json AND registering
# https://<domain>/__/auth/handler as an Authorized Redirect URI in Google Cloud Console)
VITE_FIREBASE_AUTH_DOMAIN=""
