# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# CREDENTIALS_ENCRYPTION_KEY: 32+ char secret used to encrypt WordPress/WooCommerce credentials (server-side AES-256-GCM).
# Recommended for production Vercel deployments so rotated Gemini keys do not invalidate stored WP credentials.
CREDENTIALS_ENCRYPTION_KEY=""

# Optional Google PageSpeed Insights API key (free tier works without a key at lower rate limits; key increases quota).
GOOGLE_PAGESPEED_API_KEY=""

# Optional authorized SERP rank-tracking provider (e.g., "serper" or "dataforseo") — never scrapes Google HTML directly.
SERP_API_PROVIDER=""
SERP_API_KEY=""

# Optional server-side overrides for Vercel deployment (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=""
FIREBASE_API_KEY=""
FIREBASE_DATABASE_ID=""
