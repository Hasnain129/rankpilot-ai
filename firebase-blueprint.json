        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "url", "domain", "trackingId", "seoScore", "pagesScanned", "status", "createdAt", "updatedAt"]
    },
    "TrackingKey": {
      "title": "TrackingKey",
