      "title": "UserProfile",
      "description": "Authenticated user account and workspace profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "companyName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["member"] },
        "plan": { "type": "string", "enum": ["free"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "plan", "createdAt", "updatedAt"]
    },
    "Website": {
      "title": "Website",
      "description": "Connected website tracked and analyzed by a user",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
